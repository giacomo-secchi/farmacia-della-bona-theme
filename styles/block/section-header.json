{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "slug": "section-header",
    "title": "Section Header",
    "blockTypes": [
        "core/group"
    ],
    "styles": {
        "spacing": {
            "margin": {
                "bottom": "var:preset|spacing|40"
            }
        },
        "blocks": {
            "core/paragraph": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-small",
                    "fontWeight": "300",
                    "letterSpacing": "0.1em",
                    "textTransform": "uppercase"
                },
                "spacing": {
                    "margin": {
                        "top": "0",
                        "bottom": "0"
                    }
                }
            },
            "core/term-description": {
                "typography": {
                    "fontSize": "var:preset|font-size|x-small",
                    "fontWeight": "300",
                    "letterSpacing": "0.1em",
                    "textTransform": "uppercase"
                },
                "spacing": {
                    "margin": {
                        "top": "0",
                        "bottom": "0"
                    }
                }
            }
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontSize": "var:preset|font-size|xx-large"
                },
                "spacing": {
                    "margin": {
                        "top": "var:preset|spacing|10",
                        "bottom": "0"
                    }
                }
            }
        }
    }
}
